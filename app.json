{
  "expo": {
    "name": "Mirlo Blue",
    "slug": "mirlo-blue",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mirloblue",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.mirlo.blue",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "icon": {
        "dark": "./assets/images/mirlo-logo-logoOnly-dark.png",
        "light": "./assets/images/mirlo-app-icon-light.png"
      },
      "runtimeVersion": "1.0.2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Logo-Mirlo_LogoOnly.png",
        "backgroundColor": "#070b14"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "space.mirlo.blue"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo-Mirlo_LogoOnly.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070b14"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Mirlo Blue to access your Face ID biometric data."
        }
      ],
      "expo-localization",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "797fb379-0d0b-4d23-b827-bb78570fb948"
      }
    },
    "runtimeVersion": "1.0.2",
    "owner": "drhodesw"
  }
}
